# Dependency directories
node_modules/
backend/venv/
backend/.venv/
__pycache__/
*.py[cod]
*$py.class

# Environment variables (CRITICAL: Do not commit these!)
.env
.env.local
.env.*.local

# Next.js build output
.next/
out/
build/
dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System files
.DS_Store
Thumbs.db

# IDE settings
.vscode/
.idea/
*.swp
*.swo

# Vercel
.vercel

# Test source material. Kept out of the repo deliberately: the week-one pass
# condition requires *unseen* documents, and committing one would make it
# seeded course content, which the build mandate forbids in a real request path.
*.pdf
!docs/**/*.pdf

# Stray logs
debug.log
