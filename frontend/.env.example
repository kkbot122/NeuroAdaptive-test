# Copy to frontend/.env.local and fill in. Never commit the real file.

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only. MUST match backend/.env INTERNAL_API_KEY exactly.
# Never add a NEXT_PUBLIC_ prefix to this: that inlines it into the browser
# bundle and hands the backend's shared secret to every visitor.
INTERNAL_API_KEY=

# Safe to expose — these are URLs, not secrets.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
# Used server-side inside Docker, where the backend is reachable by service name.
INTERNAL_API_URL=http://backend:8000
