{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test __tests__/*.test.mjs && node --import tsx --test __tests__/*.test.tsx",
    "typecheck": "tsc --noEmit --incremental false",
    "contracts:generate": "python3 ../backend/scripts/export_openapi.py && openapi-typescript ../backend/openapi.json -o lib/generated/api.ts",
    "contracts:check": "python3 ../backend/scripts/export_openapi.py --check && openapi-typescript ../backend/openapi.json -o lib/generated/api.ts --check"
  },
  "dependencies": {
    "@auth/core": "^0.41.0",
    "framer-motion": "^12.36.0",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^9.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "undici": "^6.28.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^20.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
