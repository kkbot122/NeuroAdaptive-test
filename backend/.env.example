# Copy to backend/.env and fill in. Never commit the real file.

DATABASE_URL=postgresql://postgres:password@db:5432/neuro_db
FRONTEND_URL=http://localhost:3000

# REQUIRED. No default is provided: a default here fails open.
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be >= 32 chars. The app refuses to start on a weak or placeholder value.
SECRET_KEY=
# Must match frontend/.env.local INTERNAL_API_KEY exactly.
INTERNAL_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GROQ_API_KEY=
# Groq retires models without notice; check https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Vector search. Inside Docker Compose this resolves via the service name;
# outside it (local dev without Docker) use http://localhost:6333.
QDRANT_URL=http://qdrant:6333
